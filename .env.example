# Do'kon paneli — faqat frontend. Server va Apple sertifikatlari markaziy MDM'da.
# Bu faylni `.env` ga nusxalang (cp .env.example .env) va to'ldiring.
# Ishga tushirish:  docker compose up -d --build

# ── Markazdan beriladigan gateway kaliti ─────────────────────────────
# SHOP_ID markazdan olinadi. SHOP_KEY: apple panel → do'kon tahrirlash →
# "Server ulanish kaliti". Kalitni almashtirgach bu faylni yangilang va
# `docker compose up -d` bajaring. SHOP_KEY brauzerga BERILMAYDI — Nginx uni
# markaziy API'ga ichki sarlavha sifatida yuboradi.
SHOP_ID=
SHOP_KEY=

# ── Domen va avtomatik SSL ───────────────────────────────────────────
# SHOP_DOMAIN — shu do'konning domeni. Birinchi `docker compose up -d --build`
# da unga avtomatik Let's Encrypt sertifikati olinadi va nginx HTTPS'ga
# sozlanadi (Nginx Proxy Manager kerak emas).
# SHART: domen DNS A-record shu serverning IP'siga ishora qilsin; 80 va 443
# portlar ochiq va bo'sh bo'lsin.
SHOP_DOMAIN=
# Let's Encrypt bildirishnomalari (sertifikat muddati) uchun email.
LETSENCRYPT_EMAIL=
# 1 = staging (test, rate-limitsiz soxta sertifikat). Haqiqiy SSL uchun 0.
CERTBOT_STAGING=0

# ── Markaziy platforma ───────────────────────────────────────────────
# Markaziy Apple platformasining ochiq manzili. Odatda o'zgarmaydi.
VITE_PUBLIC_URL=https://apple.tayyor.app

# "Google orqali kirish" tugmasi uchun ommaviy client_id (markaziy MDM bilan
# bir xil). Maxfiy client_secret bu yerda EMAS — u faqat markaziy serverda.
GOOGLE_OAUTH_CLIENT_ID=
