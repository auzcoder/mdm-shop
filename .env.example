# Do'kon paneli — faqat frontend. Server va Apple sertifikatlari markaziy MDM'da.
# SHOP_ID markazdan olinadi. SHOP_KEY: do'kon tahrirlash → Server ulanish kaliti.
# Kalitni almashtirgach ushbu faylni yangilang va docker compose up -d bajaring.
# SHOP_KEY brauzerga berilmaydi: Nginx uni markaziy API'ga ichki sarlavha sifatida yuboradi.
SHOP_ID=
SHOP_KEY=

# Markaziy Apple platformasining ochiq manzili. Odatda o'zgarmaydi.
VITE_PUBLIC_URL=https://apple.tayyor.app

# "Google orqali kirish" tugmasi uchun ommaviy client_id (markaziy MDM bilan
# bir xil). Maxfiy client_secret bu yerda EMAS — u faqat markaziy serverda.
GOOGLE_OAUTH_CLIENT_ID=

# Ushbu do'kon frontend konteynerining lokal porti.
FRONTEND_PORT=8081
